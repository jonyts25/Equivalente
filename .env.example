# Supabase (required for auth and data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI provider (default: manual ChatGPT flow)
AI_PROVIDER=manual_chatgpt

# Optional: Ollama local (dev only — do not point to localhost in Railway)
# AI_PROVIDER=ollama_local
# ENABLE_OLLAMA=true
# OLLAMA_BASE_URL=http://localhost:11434

# Optional: OpenAI API (future)
# AI_PROVIDER=openai_api
# ENABLE_OPENAI_API=true
# OPENAI_API_KEY=sk-...
